--- !u!114 &-2435850500742268146
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "If the instruction below is not checked, it seems you do not
      have an avatar in your scene.<br/> In the Runtime/Resources/GleechiHands folder,
      you will find for example <b>GleechiRig</b> which is the default avatar for
      VG.  \n\nNote that in the free version of VirtualGrasp only the <b>GleechiRig</b>
      hand is supported."
